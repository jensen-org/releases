    "lint": "eslint . --ext .ts,.vue",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@primeuix/themes": "2.0.3",
    "primevue": "4.5.5",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "latest",
    "@typescript-eslint/parser": "8.59.0",
    "@vitejs/plugin-vue": "latest",
    "@vue/test-utils": "2.4.11",
    "eslint": "latest",
    "eslint-plugin-vue": "latest",
    "jsdom": "latest",
    "typescript": "5.9.3",
    "vite": "^8.0.0",
    "vitest": "latest",
    "vue-tsc": "3.2.7"
  }
}
